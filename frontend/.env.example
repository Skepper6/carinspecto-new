# Leave empty to run in demo mode (local mock auth + local mock database).
# Fill these in to switch sign-in to Firebase Auth (email + Google).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Future: base URL of the Express API
VITE_API_URL=http://localhost:5000/api

# Stripe (publishable key only – the secret key lives in backend/.env)
VITE_STRIPE_PUBLISHABLE_KEY=
