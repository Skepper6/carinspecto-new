# Base URL of the Express API (backend/)
VITE_API_URL=http://localhost:5000/api

# Google sign-in: OAuth client ID from Google Cloud Console (leave empty to hide the "Continue with Google" button)
VITE_GOOGLE_CLIENT_ID=

# Stripe (publishable key only – the secret key lives in backend/.env)
VITE_STRIPE_PUBLISHABLE_KEY=
