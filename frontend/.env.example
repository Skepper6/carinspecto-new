# Base URL of the Express API (backend/)
VITE_API_URL=http://localhost:5000/api

# Which country this build serves: uae (default) or in. Must match MARKET in backend/.env
VITE_MARKET=

# Google sign-in: OAuth client ID from Google Cloud Console (leave empty to hide the "Continue with Google" button)
VITE_GOOGLE_CLIENT_ID=

# Stripe (publishable key only – the secret key lives in backend/.env)
VITE_STRIPE_PUBLISHABLE_KEY=


# Razorpay (India, VITE_MARKET=in): public key id only - the key secret lives in backend/.env
VITE_RAZORPAY_KEY_ID=
