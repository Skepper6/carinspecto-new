PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Public address of the website, used in email links (defaults to the first CLIENT_ORIGIN)
CLIENT_URL=
# MongoDB Atlas: Clusters > Connect > Drivers. Replace the user/password/host and keep the database name (carinspecto) before the "?"
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/carinspecto?retryWrites=true&w=majority
# Long random string used to sign login tokens (32+ characters). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web). Same value as VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
# From https://dashboard.stripe.com/apikeys (use test keys while developing). Empty = demo payments.
STRIPE_SECRET_KEY=
# Stripe dashboard > Developers > Webhooks > endpoint https://<your-api>/api/payments/webhook (charge.refunded, payment_intent.succeeded)
STRIPE_WEBHOOK_SECRET=
# DigitalOcean Spaces (private bucket) for inspection photos and attachments. Leave empty to keep them in MongoDB.
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=
DO_SPACES_KEY=
DO_SPACES_SECRET=
# Email (https://resend.com): API key and a From address on a domain you verified there, e.g. Car InspectO <no-reply@yourdomain.com>
# Empty = emails are not sent (in development the message, including reset links, is printed in this terminal).
RESEND_API_KEY=
MAIL_FROM=
